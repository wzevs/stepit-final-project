# Copy to .env and adjust. .env is git-ignored.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Dev (SQLite) needs nothing. Production example:
# DATABASE_URL=postgres://courier:password@localhost:5432/courier

# Public URL used in tracking links sent to recipients
PUBLIC_BASE_URL=http://localhost:8000
TRACKING_TOKEN_TTL_DAYS=7
TRACKING_TOKEN_GRACE_HOURS=24

# Integrations
GOOGLE_MAPS_API_KEY=
