# Copy to .env and adjust. .env is git-ignored.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Dev (SQLite) needs nothing. Production example:
# DATABASE_URL=postgres://courier:password@localhost:5432/courier

# Public URL used in tracking links sent to recipients
PUBLIC_BASE_URL=http://localhost:8000
TRACKING_TOKEN_TTL_DAYS=7
TRACKING_TOKEN_GRACE_HOURS=24

# Email — Gmail example. Create an App Password (Google Account → Security).
# Leave these empty to print mail to the runserver console instead of sending.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Galaxy Express <you@gmail.com>

# Integrations
GOOGLE_MAPS_API_KEY=

# SMS — uBill (https://my.ubill.ge). Leave empty to log SMS instead of sending.
# brandID is the numeric id of an approved sender name (e.g. test), not the name itself.
UBILL_API_URL=https://api.ubill.dev
UBILL_API_KEY=
UBILL_BRAND_ID=
SMS_BODY_PREFIX=Galaxy Express-ისგან. 
